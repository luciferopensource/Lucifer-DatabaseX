# Auto-detect text files and normalise line endings to LF
* text=auto eol=lf

# Explicit text files with LF line endings
*.ts text eol=lf diff=typescript
*.tsx text eol=lf diff=typescript
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.md text eol=lf diff=markdown
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cff text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# Windows-specific scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary file declarations
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.zip binary
*.tar.gz binary

# Export filtering (files excluded from release archives)
.github/** export-ignore
.gitlab/** export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
