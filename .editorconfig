# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript, TypeScript, JSX, and TSX files
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_style = space
indent_size = 2

# JSON and JSONC configuration files
[*.{json,jsonc,json5}]
indent_style = space
indent_size = 2

# Stylesheets (CSS, SCSS)
[*.{css,scss,less}]
indent_style = space
indent_size = 2

# HTML and WebGL shaders
[*.{html,htm,glsl,vert,frag}]
indent_style = space
indent_size = 2

# YAML and TOML configuration
[*.{yml,yaml,toml}]
indent_style = space
indent_size = 2

# Markdown documentation
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Citation File Format
[*.cff]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

# Windows batch & PowerShell scripts
[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_style = space
indent_size = 2

# Makefiles
[Makefile]
indent_style = tab
